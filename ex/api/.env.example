# Copy this file to .env and adjust if needed
# Matches the local dev Postgres container from DATABASE_SETUP.md
DATABASE_URL="postgresql://uniplay:uniplay_dev_password@localhost:5434/uniplay?schema=public"

# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-your-own-random-secret"
JWT_EXPIRES_IN_SECONDS="3600"
